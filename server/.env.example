# Copy this file to .env and add your Razorpay TEST keys first (Dashboard > Account & Settings > API Keys,
# with the dashboard switched to "Test Mode"). Never upload .env to GitHub or put these in frontend files.
RAZORPAY_KEY_ID=rzp_test_PASTE_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=PASTE_YOUR_TEST_KEY_SECRET

# Dashboard > Account & Settings > Webhooks > add this endpoint:
# https://qevnix-website.onrender.com/api/razorpay/webhook
# Set a strong webhook secret in Razorpay and copy the SAME value below (not your API Key Secret).
# Subscribe to: payment.captured, payment.failed, order.paid, subscription.activated,
# subscription.charged, subscription.pending, subscription.halted, subscription.cancelled, subscription.completed
RAZORPAY_WEBHOOK_SECRET=PASTE_YOUR_WEBHOOK_SECRET

# Monthly plans: run `node create-plans.js` ONCE, then paste the plan IDs it prints:
# RAZORPAY_PLAN_MAINTENANCE_BASIC=plan_xxxxxxxxxxxxxx
# RAZORPAY_PLAN_MAINTENANCE_STANDARD=plan_xxxxxxxxxxxxxx
# RAZORPAY_PLAN_MAINTENANCE_PREMIUM=plan_xxxxxxxxxxxxxx
# RAZORPAY_PLAN_GOOGLE_PROFILE_MANAGEMENT=plan_xxxxxxxxxxxxxx

PORT=4242
# Local test: http://localhost:4242
FRONTEND_ORIGIN=http://localhost:4242
PUBLIC_BASE_URL=http://localhost:4242
# Render Environment (backend):
# FRONTEND_ORIGIN=https://qevnix.netlify.app,https://qevnix.in,https://www.qevnix.in
# PUBLIC_BASE_URL=https://qevnix-website.onrender.com
# WEBHOOK_EVENTS_FILE=/var/data/qevnix-webhook-events.json (persistent disk recommended)

# Long random values (24+ characters). Keep private.
ADMIN_REVIEW_TOKEN=replace_with_a_long_random_secret_token
ADMIN_PROJECT_TOKEN=PASTE_A_LONG_RANDOM_ADMIN_PROJECT_TOKEN_HERE

# On hosts with temporary disks, point these to a persistent disk path:
# REVIEWS_FILE=/var/data/qevnix-reviews.json
# PROJECTS_FILE=/var/data/qevnix-projects.json
# PAYMENTS_FILE=/var/data/qevnix-payments.json

# Optional persistent storage path for webhook event deduplication on Render.
# WEBHOOK_EVENTS_FILE=/var/data/qevnix-webhook-events.json
